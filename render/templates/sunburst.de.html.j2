{% extends "_base.de.html.j2" %}
{% block title %}PräNUDGE Gesundheitsprofil — Sunburst{% endblock %}
{% block page_title %}<h1 class="page-title">Sunburst — PräNUDGE Gesundheitsprofil</h1>{% endblock %}
{% block toolbar %}
<div class="scope-bar">
  <span id="scope-label">Datensatz</span>
  <div class="scope-switch" id="scope-switch" role="group" aria-labelledby="scope-label">
    <button type="button" data-scope="combined" aria-pressed="false">Gesamt</button>
    <button type="button" data-scope="minimalset" aria-pressed="true">Minimalset</button>
    <button type="button" data-scope="extended" aria-pressed="false">Erweitert</button>
  </div>
</div>
{% endblock %}
{% block content %}
<p class="disclaimer">Im Aufbau — diese Seite zeigt vorläufige Testdaten und wird noch weiterentwickelt. Inhalt und Layout können sich noch ändern.</p>
<div class="panel sunburst-panel sunburst-standalone">
  <div id="chart-wrap" data-profile-src="../health-profile.json" data-locale="de">
    <svg id="chart"></svg>
    <div id="center">
      <img id="center-icon" alt="">
      <div id="center-title"></div>
      <div id="center-hint"></div>
    </div>
  </div>
  <p id="chart-empty" style="display:none">Keine Einträge in diesem Datensatz.</p>
  <p id="hint"></p>
  <div id="tooltip"></div>
</div>
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="scope.js"></script>
<script src="sunburst.js"></script>
{% endblock %}
