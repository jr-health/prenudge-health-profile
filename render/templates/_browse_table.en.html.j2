<table id="browse-table">
  <thead>
    <tr>
      <th>Category</th>
      <th>Indicator Dimension</th>
      <th>Observation</th>
      <th>Source Type</th>
      <th>FHIR IG Status</th>
    </tr>
  </thead>
  <tbody>
{% for cat in profile.categories %}
{% set c = cat.en %}
{% for dim in cat.dimensions %}
{% set d = dim.en %}
{% for obs in dim.observations %}
{% set o = obs.en %}
{% set instruments = o.get('measurement-instrument', []) or obs.de.get('measurement-instrument', []) %}
{% set scope_ids = {'Minimalset': 'minimalset', 'Extension': 'extended'} %}
{% set obs_scope = scope_ids.get(o.get('dataset-scope') or obs.de.get('dataset-scope'), '') %}
{% set ns = namespace(source_types=[], fhir_statuses=[], vis_statuses=[]) %}
{% for instr in instruments %}
{% if instr.get('source-type') and instr['source-type'] not in ns.source_types %}
{% set ns.source_types = ns.source_types + [instr['source-type']] %}
{% endif %}
{% if instr.get('pn-fhir-ig-status') and instr['pn-fhir-ig-status'] not in ns.fhir_statuses %}
{% set ns.fhir_statuses = ns.fhir_statuses + [instr['pn-fhir-ig-status']] %}
{% endif %}
{% if instr.get('vis-status') and instr['vis-status'] not in ns.vis_statuses %}
{% set ns.vis_statuses = ns.vis_statuses + [instr['vis-status']] %}
{% endif %}
{% endfor %}
    <tr data-category="{{ c.key | default(cat.de.key) }}" data-dimension="{{ d.key | default(dim.de.key) }}" data-observation="{{ o.key | default(obs.de.key) }}" data-scope="{{ obs_scope }}" data-source-type="{{ ns.source_types | join(' ') }}" data-fhir-status="{{ ns.fhir_statuses | join(' ') }}" data-vis-status="{{ ns.vis_statuses | join(' ') }}">
      <td><span class="swatch" style="background-color: {{ c.color | default(cat.de.color) | default('#cccccc') }};"></span>{{ c.title | default(cat.de.title) }}</td>
      <td>{{ d.title | default(dim.de.title) }}</td>
      <td>{{ o.title | default(obs.de.title) }}</td>
      <td>{% for st in ns.source_types %}<div>{{ st }}</div>{% endfor %}</td>
      <td>{% for st in ns.fhir_statuses %}<div>{{ st }}</div>{% endfor %}</td>
    </tr>
{% endfor %}
{% endfor %}
{% endfor %}
  </tbody>
</table>
{# Status text is data-driven so browse.js stays locale-agnostic - the German
   partial supplies the same placeholders with German wording. #}
<div class="table-pager">
  <button type="button" class="pager-btn" id="pager-prev" aria-label="Previous page">‹</button>
  <span id="pager-status" aria-live="polite"
        data-format="{from}–{to} of {total} observations"
        data-empty="No observations match this selection"></span>
  <button type="button" class="pager-btn" id="pager-next" aria-label="Next page">›</button>
</div>
