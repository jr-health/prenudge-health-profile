<table id="browse-table">
  <thead>
    <tr>
      <th>Kategorie</th>
      <th>Beobachtung / Gesundheitsindikator</th>
      <th>Messinstrument</th>
      <th>FHIR IG</th>
    </tr>
  </thead>
  <tbody>
{% for cat in profile.categories %}
{% set c = cat.de %}
{% for dim in cat.dimensions %}
{% for obs in dim.observations %}
{% set o = obs.de %}
{% set instruments = o.get('measurement-instrument', []) %}
{% set scope_ids = {'Minimalset': 'minimalset', 'Extension': 'extended'} %}
{% set obs_scope = scope_ids.get(o.get('dataset-scope'), '') %}
{% set ns = namespace(source_types=[], fhir_statuses=[], fhir_links=[], vis_statuses=[]) %}
{% for instr in instruments %}
{% if instr.get('source-type') and instr['source-type'] not in ns.source_types %}
{% set ns.source_types = ns.source_types + [instr['source-type']] %}
{% endif %}
{% if instr.get('pn-fhir-ig-status') and instr['pn-fhir-ig-status'] not in ns.fhir_statuses %}
{% set ns.fhir_statuses = ns.fhir_statuses + [instr['pn-fhir-ig-status']] %}
{% endif %}
{% if instr.get('pn-fhir-ig-link') and instr['pn-fhir-ig-link'] not in ns.fhir_links %}
{% set ns.fhir_links = ns.fhir_links + [instr['pn-fhir-ig-link']] %}
{% endif %}
{% if instr.get('vis-status') and instr['vis-status'] not in ns.vis_statuses %}
{% set ns.vis_statuses = ns.vis_statuses + [instr['vis-status']] %}
{% endif %}
{% endfor %}
    <tr data-category="{{ c.key }}" data-observation="{{ o.key }}" data-scope="{{ obs_scope }}" data-source-type="{{ ns.source_types | join(' ') }}" data-fhir-status="{{ ns.fhir_statuses | join(' ') }}" data-vis-status="{{ ns.vis_statuses | join(' ') }}">
      <td><span class="swatch" style="background-color: {{ c.color | default('#cccccc') }};"></span>{{ c.title | default(cat.en.title) }}</td>
      <td>{{ o.title | default(obs.en.title) }}</td>
      <td>{% for st in ns.source_types %}<div>{{ st }}</div>{% endfor %}</td>
      <td>{% for link in ns.fhir_links %}<div><a href="{{ link }}" target="_blank" rel="noopener">{{ link.split('/')[-1] | replace('.html', '') }}</a></div>{% endfor %}</td>
    </tr>
{% endfor %}
{% endfor %}
{% endfor %}
  </tbody>
</table>
{# Statustext ist datengetrieben, damit browse.js sprachunabhängig bleibt - das
   englische Partial liefert dieselben Platzhalter mit englischem Wortlaut. #}
<div class="table-pager">
  <button type="button" class="pager-btn" id="pager-prev" aria-label="Vorherige Seite">‹</button>
  <span id="pager-status" aria-live="polite"
        data-format="{from}–{to} von {total} Observations"
        data-empty="Keine Observations für diese Auswahl"></span>
  <button type="button" class="pager-btn" id="pager-next" aria-label="Nächste Seite">›</button>
</div>
