{% extends "_base.en.html.j2" %}
{% block title %}PreNUDGE Health Profile — Sunburst{% endblock %}
{% block page_title %}<h1 class="page-title">Sunburst — PreNUDGE Health Profile</h1>{% endblock %}
{% block toolbar %}
<div class="scope-bar">
  <span id="scope-label">Data set</span>
  <div class="scope-switch" id="scope-switch" role="group" aria-labelledby="scope-label">
    <button type="button" data-scope="combined" aria-pressed="false">All</button>
    <button type="button" data-scope="minimalset" aria-pressed="true">Minimal</button>
    <button type="button" data-scope="extended" aria-pressed="false">Extended</button>
  </div>
</div>
{% endblock %}
{% block content %}
<p class="disclaimer">Under construction — this page shows preliminary test data and is still being built out. Content and layout are subject to change.</p>
<div class="panel sunburst-panel sunburst-standalone">
  <div id="chart-wrap" data-profile-src="../health-profile.json" data-locale="en">
    <svg id="chart"></svg>
    <div id="center">
      <img id="center-icon" alt="">
      <div id="center-title"></div>
      <div id="center-hint"></div>
    </div>
  </div>
  <p id="chart-empty" style="display:none">No entries in this data set.</p>
  <p id="hint"></p>
  <div id="tooltip"></div>
</div>
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="scope.js"></script>
<script src="sunburst.js"></script>
{% endblock %}
